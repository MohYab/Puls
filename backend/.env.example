PORT=3001
DATABASE_URL="postgresql://username:password@localhost:5432/dbname?schema=public"
# At least 32 random characters in production: openssl rand -base64 48
JWT_SECRET=your-secret-key-here
# The clinic's time zone. Calendar days (date, from, to) are counted in it (decision #57).
TZ=Europe/Stockholm
# Production only: comma-separated origins allowed to call the API, e.g.
# CORS_ORIGIN=https://puls-frontend.onrender.com
# Leave unset in development to allow every origin (phone testing on the local network).
# CORS_ORIGIN=
# Set to "production" on the server. Enables the checks above and "trust proxy".
# NODE_ENV=production