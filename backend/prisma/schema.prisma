// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PatientDeactivationReason {
  DECEASED
  MOVED
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  doctor            Doctor?
  createdNoteShares NoteShare[]
  statusChanges     AppointmentStatusChange[]

  @@map("users")
}

model Doctor {
  id             String  @id @default(cuid())
  userId         String  @unique
  specialization String?

  user         User           @relation(fields: [userId], references: [id])
  appointments Appointment[]
  notes        ClinicalNote[]
  noteShares   NoteShare[]

  @@map("doctors")
}

model Patient {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  phone       String?
    email       String?
  createdAt   DateTime @default(now())

  // Patients are never deleted: their records must be kept (Patient Data Act).
  isActive           Boolean                    @default(true)
  deactivatedAt      DateTime?
  deactivationReason PatientDeactivationReason?

  appointments Appointment[]
  notes        ClinicalNote[]

  @@map("patients")
}

model AppointmentType {
  id          String  @id @default(cuid())
  name        String
  duration    Int // minutes
    description String?
  isActive    Boolean @default(true)

  appointments Appointment[]

  @@map("appointment_types")
}

model Appointment {
  id                String            @id @default(cuid())
  patientId         String
  doctorId          String
  appointmentTypeId String
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus @default(SCHEDULED)
  bookingComment    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  patient         Patient         @relation(fields: [patientId], references: [id])
  doctor          Doctor          @relation(fields: [doctorId], references: [id])
  appointmentType AppointmentType @relation(fields: [appointmentTypeId], references: [id])
  note            ClinicalNote?
  statusChanges   AppointmentStatusChange[]

  @@index([doctorId, startTime])
  @@map("appointments")
}

model ClinicalNote {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  patientId     String
  doctorId      String
  templateId    String?
  content       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment Appointment            @relation(fields: [appointmentId], references: [id])
  patient     Patient                @relation(fields: [patientId], references: [id])
  doctor      Doctor                 @relation(fields: [doctorId], references: [id])
  template    DocumentationTemplate? @relation(fields: [templateId], references: [id])
  shares      NoteShare[]

  @@map("clinical_notes")
}

model DocumentationTemplate {
  id              String  @id @default(cuid())
  name            String
  description     String?
  templateContent Json

  notes ClinicalNote[]

  @@map("documentation_templates")
}

// A doctor's read access to another doctor's note. Revoking sets revokedAt
// instead of deleting, and sharing again creates a new row, so the full
// history of who had access and when is kept.
model NoteShare {
  id                 String    @id @default(cuid())
  noteId             String
  doctorId           String // recipient
  createdByUserId    String // today always the author; later possibly the patient
  consentConfirmedAt DateTime // simulated consent in the MVP
  createdAt          DateTime  @default(now())
  revokedAt          DateTime? // null = active

  note      ClinicalNote @relation(fields: [noteId], references: [id])
  doctor    Doctor       @relation(fields: [doctorId], references: [id])
  createdBy User         @relation(fields: [createdByUserId], references: [id])

  @@index([noteId, doctorId])
  @@map("note_shares")
}

// Every status change of an appointment, including admin corrections.
// Nothing is updated or deleted here: the table is the history.
model AppointmentStatusChange {
  id              String            @id @default(cuid())
  appointmentId   String
  fromStatus      AppointmentStatus
  toStatus        AppointmentStatus
  changedByUserId String
  reason          String? // required when an admin corrects a final status
  createdAt       DateTime          @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  changedBy   User        @relation(fields: [changedByUserId], references: [id])

  @@index([appointmentId, createdAt])
  @@map("appointment_status_changes")
}